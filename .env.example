# Copy to .env and fill in. .env is gitignored: it describes one host, and
# host layout is not something an open repository should publish.

# Image to run. CI prints the exact value after a successful build.
AGENT_POLICE_IMAGE=ghcr.io/<owner>/agent-police:latest

# Optional: container name, if the default collides with something.
# AGENT_POLICE_CONTAINER=agent-police

# Public HTTPS base of the collector. Canary URLs planted in probe traffic
# point here, so it must be reachable from anywhere. Serve it through your
# reverse proxy, and prefer a DNS-only record over a proxied/CDN one: a WAF
# that challenges automated clients will swallow exactly the callbacks the
# collector exists to record.
AGENT_POLICE_CANARY_BASE=https://security.example.com

# The docker network your reverse proxy is already attached to.
AGENT_POLICE_PROXY_NETWORK=your_proxy_network

# --- DNS canaries (optional) ------------------------------------------------
# Catch scanners that resolve a harvested hostname without ever fetching it.
# Requires a delegation in the parent zone:
#
#     c.example.com.   IN  NS  security.example.com.
#
# and UDP/53 open. The NS target must be a DNS-only record pointing at this
# host: a CDN-proxied name resolves to the CDN's anycast addresses, which do
# not run this collector.
#
# Leave AGENT_POLICE_CANARY_DNS empty until the delegation is live. With a
# zone set but unreachable, the provider issues DNS canaries that can never
# fire, which is worse than falling back to HTTP ones.
AGENT_POLICE_CANARY_DNS=
AGENT_POLICE_DNS_A=
AGENT_POLICE_DNS_AAAA=
AGENT_POLICE_DNS_NS=

# Addresses the DNS collector binds to. Use the host's own public addresses,
# not 0.0.0.0, so the bind does not collide with a local resolver stub.
AGENT_POLICE_DNS_BIND_V4=203.0.113.10
AGENT_POLICE_DNS_BIND_V6=2001:db8::1
